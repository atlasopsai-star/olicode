{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "darkBg":       "#060810",
    "darkPanel":    "#0a0d15",
    "darkElement":  "#10141d",
    "darkBorder1":  "#181b24",
    "darkBorder2":  "#252936",
    "darkBorder3":  "#373c4b",
    "darkMuted1":   "#465064",
    "darkMuted2":   "#657087",
    "darkGold":     "#d9aa52",
    "darkGoldHi":   "#f2cf83",
    "darkTextMute": "#81899a",
    "darkText":     "#dce0e7",
    "darkBlue":     "#6d91c9",
    "darkCyan":     "#63b8b0",
    "darkGreen":    "#69b983",
    "darkRed":      "#d76570",
    "darkOrange":   "#d28a55",
    "darkPurple":   "#9a80bd",
    "darkYellow":   "#c9a958",
    "darkMagenta":  "#b975a3",

    "lightBg":       "#f4f6fb",
    "lightPanel":    "#edf0f8",
    "lightElement":  "#e5eaf5",
    "lightBorder1":  "#cdd4e8",
    "lightBorder2":  "#b8c2da",
    "lightBorder3":  "#9aa8cc",
    "lightMuted1":   "#8090b8",
    "lightMuted2":   "#6070a0",
    "lightGold":     "#b87a00",
    "lightGoldHi":   "#8a5a00",
    "lightTextMute": "#6070a0",
    "lightText":     "#1a2040",
    "lightBlue":     "#1a60c8",
    "lightCyan":     "#007888",
    "lightGreen":    "#1a7a40",
    "lightRed":      "#c0203c",
    "lightOrange":   "#c05010",
    "lightPurple":   "#6040c8",
    "lightYellow":   "#906010"
  },
  "theme": {
    "primary":        { "dark": "darkGold",     "light": "lightGold" },
    "secondary":      { "dark": "darkGoldHi",   "light": "lightGoldHi" },
    "accent":         { "dark": "darkGoldHi",   "light": "lightGoldHi" },
    "error":          { "dark": "darkRed",      "light": "lightRed" },
    "warning":        { "dark": "darkOrange",   "light": "lightOrange" },
    "success":        { "dark": "darkGreen",    "light": "lightGreen" },
    "info":           { "dark": "darkCyan",     "light": "lightCyan" },
    "text":           { "dark": "darkText",     "light": "lightText" },
    "textMuted":      { "dark": "darkTextMute", "light": "lightTextMute" },
    "background":     { "dark": "darkBg",       "light": "lightBg" },
    "backgroundPanel":  { "dark": "darkPanel",   "light": "lightPanel" },
    "backgroundElement": { "dark": "darkElement", "light": "lightElement" },
    "border":         { "dark": "darkBorder3",  "light": "lightBorder3" },
    "borderActive":   { "dark": "darkMuted2",   "light": "lightMuted2" },
    "borderSubtle":   { "dark": "darkBorder2",  "light": "lightBorder2" },
    "diffAdded":        { "dark": "darkCyan",    "light": "lightCyan" },
    "diffRemoved":      { "dark": "darkRed",     "light": "lightRed" },
    "diffContext":      { "dark": "darkMuted1",  "light": "lightMuted1" },
    "diffHunkHeader":   { "dark": "darkMuted1",  "light": "lightMuted1" },
    "diffHighlightAdded":   { "dark": "darkGreen",  "light": "lightGreen" },
    "diffHighlightRemoved": { "dark": "darkRed",    "light": "lightRed" },
    "diffAddedBg":          { "dark": "#0a1f18",    "light": "#d0ecdc" },
    "diffRemovedBg":        { "dark": "#1f0a12",    "light": "#f5d0d8" },
    "diffContextBg":        { "dark": "darkPanel",  "light": "lightPanel" },
    "diffLineNumber":       { "dark": "darkMuted1", "light": "lightMuted1" },
    "diffAddedLineNumberBg":   { "dark": "#081810", "light": "#c0dcc8" },
    "diffRemovedLineNumberBg": { "dark": "#180810", "light": "#e8c8cc" },
    "markdownText":        { "dark": "darkText",     "light": "lightText" },
    "markdownHeading":     { "dark": "darkGold",     "light": "lightGold" },
    "markdownLink":        { "dark": "darkGold",     "light": "lightGold" },
    "markdownLinkText":    { "dark": "darkCyan",     "light": "lightCyan" },
    "markdownCode":        { "dark": "darkGreen",    "light": "lightGreen" },
    "markdownBlockQuote":  { "dark": "darkYellow",   "light": "lightYellow" },
    "markdownEmph":        { "dark": "darkYellow",   "light": "lightYellow" },
    "markdownStrong":      { "dark": "darkGold",     "light": "lightGold" },
    "markdownHorizontalRule": { "dark": "darkMuted2", "light": "lightMuted2" },
    "markdownListItem":    { "dark": "darkGold",     "light": "lightGold" },
    "markdownListEnumeration": { "dark": "darkCyan", "light": "lightCyan" },
    "markdownImage":       { "dark": "darkGold",     "light": "lightGold" },
    "markdownImageText":   { "dark": "darkCyan",     "light": "lightCyan" },
    "markdownCodeBlock":   { "dark": "darkText",     "light": "lightText" },
    "syntaxComment":   { "dark": "darkMuted2",  "light": "lightMuted2" },
    "syntaxKeyword":   { "dark": "darkPurple",  "light": "lightPurple" },
    "syntaxFunction":  { "dark": "darkGold",    "light": "lightGold" },
    "syntaxVariable":  { "dark": "darkRed",     "light": "lightRed" },
    "syntaxString":    { "dark": "darkGreen",   "light": "lightGreen" },
    "syntaxNumber":    { "dark": "darkOrange",  "light": "lightOrange" },
    "syntaxType":      { "dark": "darkCyan",    "light": "lightCyan" },
    "syntaxOperator":  { "dark": "darkBlue",    "light": "lightBlue" },
    "syntaxPunctuation": { "dark": "darkText",  "light": "lightText" }
  }
}
